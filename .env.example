# ---------------------------------------------------------------------------
# ContentCal — environment template. Copy to .env and fill in real values.
# NEVER commit .env. Secrets live only in .env (gitignored) or a secret manager.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# asyncpg URL used by the API, worker, and Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/content_cal

# --- Redis / job queue (Memurai on Windows, Redis elsewhere) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Credential encryption (future OAuth tokens stored at rest) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# --- API ---
API_HOST=0.0.0.0
# 8010 is the default; change freely (keep NEXT dev proxy in apps/web/next.config.ts in sync)
API_PORT=8010
CORS_ORIGINS=http://localhost:3000
# Maximum upload size in megabytes
MAX_UPLOAD_MB=50
# Local media storage directory (use object storage in production)
MEDIA_STORAGE_DIR=media

# --- Open scheduler tick (seconds) ---
SCHEDULER_TICK_SECONDS=30
JOB_MAX_RETRIES=3

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8010
